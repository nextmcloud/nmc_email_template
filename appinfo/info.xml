<?xml version="1.0"?>
<info>
	<id>nmc_email_template</id>
	<name>NMC E-Mail Template</name>
	<description>Example E-Mail Template for Nextcloud</description>
	<licence>AGPL</licence>
	<author>Marius Blüm</author>
	<version>33.0.1</version>
	<namespace>NmcEmailTemplate</namespace>

	<category>customization</category>

	<dependencies>
		<nextcloud min-version="30" max-version="34" />
	</dependencies>

	<types>
		<logging/>
	</types>

	<repair-steps>
		<install>
			<step>OCA\NmcEmailTemplate\Migration\SetEmailTemplate</step>
		</install>
		<uninstall>
			<step>OCA\NmcEmailTemplate\Migration\UnsetEmailTemplate</step>
		</uninstall>
	</repair-steps>
</info>
